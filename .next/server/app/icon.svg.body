<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
  <!--
    The Chorus mark on a dark tile, so it reads on light and dark tab strips.
    Every bar edge is an even number, so at 16px each one lands on a whole
    pixel instead of blurring across two.
    Source for favicon.ico and apple-icon.png: npm run icons
  -->
  <rect width="32" height="32" rx="7" fill="#0a1215"/>
  <rect x="4" y="16" width="4" height="10" rx="2" fill="#16a394" opacity="0.6"/>
  <rect x="10" y="12" width="4" height="14" rx="2" fill="#16a394" opacity="0.85"/>
  <rect x="16" y="6" width="4" height="20" rx="2" fill="#e8912f"/>
  <rect x="22" y="14" width="4" height="12" rx="2" fill="#16a394" opacity="0.7"/>
</svg>
