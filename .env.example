# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct connection, used by migrations and long transactions.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication (Auth.js)
# ---------------------------------------------------------------------------
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
# Required when the app is served on a host Auth.js cannot infer
# (reverse proxies, custom domains, or an address other than AUTH_URL).
AUTH_TRUST_HOST="true"

# Public origin, used to build join links and QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Realtime
# ---------------------------------------------------------------------------
# Optional. Leave these blank to use the built-in Server-Sent Events driver,
# which is genuine server push but only reaches clients on the same Node
# process — fine for local development and single-node deployments.
#
# Set all four to switch to Pusher, which is required on multi-instance
# serverless hosts such as Vercel. Create a free app at pusher.com/channels.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ---------------------------------------------------------------------------
# Participant sessions
# ---------------------------------------------------------------------------
# Signs the anonymous participant cookie. Generate like AUTH_SECRET.
PARTICIPANT_COOKIE_SECRET="replace-me"

# ---------------------------------------------------------------------------
# Server Actions
# ---------------------------------------------------------------------------
# Comma-separated extra origins allowed to submit forms, on top of localhost.
# Required behind a reverse proxy or custom domain, or forms silently do nothing.
SERVER_ACTION_ALLOWED_ORIGINS=""
